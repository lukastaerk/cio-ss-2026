{
    "version": "2.0.0",
    "tasks": [
        {
            // Configures + builds the project that owns the active .cpp file
            // (src/foo.cpp -> project dir is ${fileDirname}/..)
            "label": "cmake build (current project)",
            "type": "shell",
            "command": "cmake --preset debug && cmake --build build",
            "options": {
                "cwd": "${fileDirname}/.."
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "silent",
                "clear": true
            }
        }
    ]
}
